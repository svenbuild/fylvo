<?xml version="1.0" encoding="utf-8"?>
<!-- Fylvo: https only, system certificate authorities only (no user-installed CAs).
     Debug builds replace this file with src/debug/res/xml/network_security_config.xml. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
