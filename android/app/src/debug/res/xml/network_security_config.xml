<?xml version="1.0" encoding="utf-8"?>
<!-- TEST ONLY, debug builds only. Allows plain http to two test addresses:
     the NAS on the home network and 10.0.2.2, the emulator's address of the PC
     (a Fylvo server on http://127.0.0.1:5212 there).
     Release builds use src/main/res/xml/network_security_config.xml, which blocks all plain
     http. To switch the exception off for debug builds too, delete this file. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.1.112</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
