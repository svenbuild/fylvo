          Square310x310Logo="Images\LargeTile.png" Square71x71Logo="Images\SmallTile.png" />
      </uap:VisualElements>
      <uap7:Properties>
        <uap8:ActiveCodePage>UTF-8</uap8:ActiveCodePage>
      </uap7:Properties>
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="fylvo-desktop.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="fylvo" Enabled="true" DisplayName="Fylvo Desktop"/>
        </desktop:Extension>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="fylvo" />
        </uap:Extension>
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation
            ToastActivatorCLSID="2e3cbb7d-b6b5-4455-9a0e-30a4df5244dd" />
        </desktop:Extension>
        <desktop3:Extension Category="windows.cloudFiles">
          <desktop3:CloudFiles>
            <desktop3:CustomStateHandler Clsid="3a26ed18-5fa7-44e4-b90d-e8a16311dcf6" />
            <desktop3:ThumbnailProviderHandler Clsid="328647e6-b043-4b66-a028-d6a9fd7806e3" />
            <desktop3:ExtendedPropertyHandler Clsid="1e4b7500-121f-4f06-88ef-9dfcae2167f1" />
            <desktop3:BannersHandler Clsid="1e4b7500-121f-4f06-88ef-9dfcae2167f1" />
            <cloudfiles2:StorageProviderStatusUISourceFactory
              Clsid="a3bb5be9-8d58-414b-a6b0-e4a30e5cbef1" />
            <desktop3:CloudFilesContextMenus>
              <desktop3:Verb Id="Command1" Clsid="06cff32f-efcf-4dc0-a648-02de0b23d637" />
            </desktop3:CloudFilesContextMenus>
            <desktop4:ContentUriSource Clsid="aa0d0dec-1bc4-4d7b-8161-8fd87de872a4" />
          </desktop3:CloudFiles>
        </desktop3:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="fylvo-desktop.exe"
              DisplayName="Fylvo Toast activator">
              <com:Class Id="2e3cbb7d-b6b5-4455-9a0e-30a4df5244dd"
                DisplayName="Fylvo Toast activator" />
            </com:ExeServer>
            <com:ExeServer DisplayName="Fylvo Command Handler"
              Executable="fylvo-desktop.exe">
              <com:Class Id="06cff32f-efcf-4dc0-a648-02de0b23d637" />
            </com:ExeServer>
            <com:ExeServer DisplayName="Fylvo Custom State Handler"
              Executable="fylvo-desktop.exe">
              <com:Class Id="3a26ed18-5fa7-44e4-b90d-e8a16311dcf6" />
            </com:ExeServer>
            <com:ExeServer DisplayName="Fylvo Status UI Source Factory"
              Executable="fylvo-desktop.exe">
              <com:Class Id="a3bb5be9-8d58-414b-a6b0-e4a30e5cbef1" />
            </com:ExeServer>
            <com:ExeServer DisplayName="Fylvo Thumbnail Handler"
              Executable="fylvo-desktop.exe">
              <com:Class Id="328647e6-b043-4b66-a028-d6a9fd7806e3" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="broadFileSystemAccess" />
  </Capabilities>
</Package>