# Optional settings for docker-compose.yml. Copy this file to .env, remove the # in front of the
# lines you need and change the values. Then: docker compose up -d

# The address people use to open Fylvo, without a slash at the end. Share links use it, and
# office needs it.
#FYLVO_URL=https://cloud.example.com

# Where Fylvo listens. The default 127.0.0.1:5212 is only this machine, right for a reverse proxy
# on it. To use Fylvo in your home network without a proxy, after creating the admin account:
#FYLVO_BIND=5212

# Your time zone, for logs and scheduled jobs.
#TZ=Europe/Berlin

# Reverse proxies in front of Fylvo (IPs or networks, comma separated). Fylvo then sees the real
# address of each visitor, which the limit on wrong passwords needs. For a proxy on the same
# machine that reaches Fylvo through the published port:
#FYLVO_TRUSTED_PROXIES=172.16.0.0/12

# Office engines in use, the default first: craft (built in), collabora (needs FYLVO_OFFICE_URL).
#FYLVO_OFFICE_ENGINE=craft,collabora

# Office (docker compose --profile office up -d): the address browsers use to reach it. It needs
# its own host name or port.
#FYLVO_OFFICE_URL=https://office.example.com
#OFFICE_BIND=9980
# OFFICE_BIND=9980: office in your home network without a proxy.
# true when your reverse proxy serves the office address over https.
#OFFICE_BEHIND_HTTPS=true
